root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,css,html}]
indent_style = space
indent_size = 4

[*.cs]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{asset,prefab,unity,mat,meta}]
indent_style = space
indent_size = 2
